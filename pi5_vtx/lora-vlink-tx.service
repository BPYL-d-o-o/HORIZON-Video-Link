[Unit]
Description=Horizon video link transmitter (Pi camera -> x265 -> TX RP2350 vlive_tx over SPI or USB)
After=network-online.target
Wants=network-online.target

[Service]
User=test
WorkingDirectory=/home/test/pi5_vtx
# control FIFO for TX power changes while running (pi5_vtx/tx_power.sh): /run/lora-vlink-tx/ctl
RuntimeDirectory=lora-vlink-tx
RuntimeDirectoryMode=0775
Environment=LORA_TX_CTL=/run/lora-vlink-tx/ctl
# extra live_sender.py options, e.g. LORA_TX_ARGS="--tx-power -19" or "--link usb" (setup_pi_vtx.sh creates it)
EnvironmentFile=-/etc/default/lora-vlink-tx
ExecStart=/usr/bin/python3 -u /home/test/pi5_vtx/live_sender.py $LORA_TX_ARGS
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
